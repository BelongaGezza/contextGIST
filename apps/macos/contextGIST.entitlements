<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox with no additional entitlements: contextGIST never
         reads/writes files, never touches the network, and never persists
         anything. Services-menu pasteboard delivery is handled by the OS
         and needs no sandbox exception. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
