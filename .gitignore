# Rust
/target/

# uniffi-generated Swift bindings — regenerated by tools/gen-bindings.sh
/apps/macos/Generated/

# Xcode project — generated by `xcodegen generate`, never committed (mirrors GIST)
/apps/macos/contextGIST.xcodeproj/

# macOS
.DS_Store
/.upstream/

# Packaged macOS build output (tools/package-macos.sh): the DMG, INSTALL.txt and
# README are committed; the unpacked .app is not (it's inside the DMG)
/dist/macos/contextGIST.app/
# Unpacked/intermediate build trees for other platforms; installers + INSTALL.txt are committed
/dist/windows/*/
/dist/linux/*/

# Never commit signing material, backups, or raw capture data (S-17)
*.p12
*.pfx
*.cer
*.key
*.pem
*.mobileprovision
*.provisionprofile
*.bak
*.orig
*.csv
.env
.env.*
